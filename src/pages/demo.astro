---
/**
 * /demo — Solicitud de demo · Vecinal
 * ------------------------------------------------------------
 * Ubicación: src/pages/demo.astro
 *
 * · Formulario con Netlify Forms (sin backend). Al enviar redirige a
 *   /gracias. Honeypot `bot-field` contra spam.
 * · Plan preseleccionable por URL:  /demo?plan=esencial | profesional | corporativo
 *   (cambia también el título y el texto del botón).
 * · Captura utm_source / utm_medium / utm_campaign desde la URL.
 * · Incluye autorización de tratamiento de datos (Ley 1581 de 2012).
 *
 * ⚙️ AJUSTA ESTAS CONSTANTES:
 */
import Base from "../layouts/Base.astro";
import "../styles/global.css"; // ← ajusta la ruta si tu CSS vive en otro lugar

const WHATSAPP = "573000000000"; // ← número de ventas, con indicativo país, sin "+"
const TIEMPO_RESPUESTA = "menos de 24 horas hábiles"; // ← lo que prometes en la página
const POLITICA_URL = "/privacidad"; // ← política de tratamiento de datos

const waLink = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent("Hola, quiero ver una demo de Vecinal.")}`;

// Iconos SVG (viewBox 24x24, estilo Lucide)
const icons = {
  arrowRight: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  arrowLeft: '<path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>',
  clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
  calendarCheck:
    '<rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/>',
  shieldCheck:
    '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  messageCircle: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>',
};

const benefits = [
  { icon: icons.clock, title: "Configuración en menos de 48 horas", text: "Asistida por nuestro equipo, sin tecnicismos." },
  { icon: icons.calendarCheck, title: "Migración asistida de 3 a 7 días", text: "Cargamos tus datos desde Excel y tú solo verificas." },
  { icon: icons.shieldCheck, title: "14 días sin tarjeta", text: "Si no te ahorra tiempo en el primer mes, te devolvemos el dinero." },
];

const textFields = [
  { id: "nombre", label: "Nombre completo", type: "text", autocomplete: "name", placeholder: "Mariana Gómez", span: true },
  { id: "whatsapp", label: "WhatsApp", type: "tel", autocomplete: "tel", placeholder: "300 123 4567", inputmode: "tel" },
  { id: "email", label: "Correo electrónico", type: "email", autocomplete: "email", placeholder: "tu@correo.com" },
  { id: "organizacion", label: "Conjunto o administradora", type: "text", autocomplete: "organization", placeholder: "Nombre de tu conjunto o empresa", span: true },
] as const;

const field =
  "mt-1.5 block min-h-12 w-full rounded-control border border-line bg-white px-4 py-3 text-base text-ink placeholder:text-ink-soft/70 transition-colors focus:border-accent focus:outline-2 focus:outline-accent/30";
---

<Base title="Vecinal — Tu condominio, bajo control">

    <main class="bg-linear-to-b from-brand to-brand-deep section-pad">
      <div class="container-x grid gap-8 lg:grid-cols-[5fr_6fr] lg:grid-rows-[auto_1fr] lg:gap-x-14 lg:gap-y-8">
        <!-- Título -->
        <div class="rise lg:col-start-1 lg:row-start-1">
          <p class="eyebrow-dark">Demo gratuita</p>
          <h1 id="demo-title" class="text-4xl font-extrabold leading-[1.08] text-white sm:text-5xl">
            Solicita tu <span class="text-accent-bright">demo gratuita</span>
          </h1>
          <p class="mt-4 max-w-xl text-lg leading-relaxed text-white/75">
            Cuéntanos de tu conjunto y te mostramos cómo Vecinal reemplaza tus hojas de cálculo, sin compromiso.
          </p>
        </div>

        <!-- Formulario -->
        <div class="rise rounded-card bg-white p-6 shadow-pop sm:p-8 lg:col-start-2 lg:row-span-2 lg:row-start-1">
          <p class="mb-6 flex items-center gap-2 text-sm font-semibold text-accent">
            <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.clock} />
            Te respondemos en {TIEMPO_RESPUESTA}
          </p>

          <form
            id="demo-form"
            name="demo"
            method="POST"
            action="/gracias"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="grid gap-4 sm:grid-cols-2"
          >
            <input type="hidden" name="form-name" value="demo" />
            <input type="hidden" name="utm_source" />
            <input type="hidden" name="utm_medium" />
            <input type="hidden" name="utm_campaign" />
            <p class="hidden" aria-hidden="true">
              <label>No llenar este campo: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
            </p>

            {
              textFields.map((f) => (
                <div class:list={["span" in f && f.span && "sm:col-span-2"]}>
                  <label for={f.id} class="text-sm font-semibold text-brand">{f.label}</label>
                  <input
                    id={f.id}
                    name={f.id}
                    type={f.type}
                    autocomplete={f.autocomplete}
                    inputmode={"inputmode" in f ? f.inputmode : undefined}
                    placeholder={f.placeholder}
                    required
                    class={field}
                  />
                </div>
              ))
            }

            <div>
              <label for="unidades" class="text-sm font-semibold text-brand">Unidades que administras</label>
              <select id="unidades" name="unidades" required class={field}>
                <option value="" disabled selected>Selecciona un rango</option>
                <option value="hasta-100">Hasta 100</option>
                <option value="101-500">101 a 500</option>
                <option value="501-2000">501 a 2.000</option>
                <option value="mas-2000">Más de 2.000</option>
              </select>
            </div>

            <div>
              <label for="plan" class="text-sm font-semibold text-brand">Plan de interés</label>
              <select id="plan" name="plan" class={field}>
                <option value="no-se">Aún no lo sé</option>
                <option value="esencial">Esencial</option>
                <option value="profesional">Profesional</option>
                <option value="corporativo">Corporativo</option>
              </select>
            </div>

            <!-- Autorización de datos personales (Ley 1581 de 2012) -->
            <div class="sm:col-span-2">
              <label class="flex items-start gap-3 text-sm leading-relaxed text-ink-soft">
                <input type="checkbox" name="autorizacion" required class="mt-1 size-5 shrink-0 rounded border-line accent-accent" />
                <span>
                  Autorizo el tratamiento de mis datos personales para que Vecinal me contacte, según su
                  <a href={POLITICA_URL} class="link-brand" target="_blank" rel="noopener">Política de Tratamiento de Datos</a>.
                </span>
              </label>
            </div>

            <div class="sm:col-span-2">
              <button id="demo-submit" type="submit" class="btn-primary group w-full py-4 text-lg disabled:cursor-wait disabled:opacity-70 cursor-pointer">
                <span id="demo-submit-label">Solicitar demo gratuita</span>
                <svg viewBox="0 0 24 24" class="size-5 motion-safe:transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.arrowRight} />
              </button>
              <p class="mt-3 text-center text-xs text-ink-soft">Sin tarjeta de crédito. Sin compromiso.</p>
            </div>
          </form>
        </div>

        <!-- Beneficios + alternativa WhatsApp -->
        <div class="rise lg:col-start-1 lg:row-start-2">
          <ul role="list" class="space-y-5">
            {
              benefits.map((b) => (
                <li class="flex items-start gap-4">
                  <span class="grid size-11 shrink-0 place-items-center rounded-control bg-white/10 text-accent-bright" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={b.icon} />
                  </span>
                  <div>
                    <h2 class="font-display text-lg font-bold text-white">{b.title}</h2>
                    <p class="mt-0.5 text-sm leading-relaxed text-white/70">{b.text}</p>
                  </div>
                </li>
              ))
            }
          </ul>

          <div class="mt-8 flex flex-wrap items-center gap-4 rounded-card border border-white/10 bg-white/5 p-5">
            <div class="min-w-0 flex-1">
              <p class="font-display font-bold text-white">¿Prefieres hablar ya?</p>
              <p class="mt-0.5 text-sm text-white/70">Escríbenos y te atendemos directamente.</p>
            </div>
            <a href={waLink} target="_blank" rel="noopener" class="btn-secondary">
              <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.messageCircle} />
              Escribir por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </main>

  

    <script>
      // 1) Plan preseleccionado por URL: /demo?plan=esencial|profesional|corporativo
      const params = new URLSearchParams(window.location.search);
      const plan = params.get("plan");
      const select = document.getElementById("plan") as HTMLSelectElement | null;
      const title = document.getElementById("demo-title");
      const label = document.getElementById("demo-submit-label");

      const copy: Record<string, { title: string; cta: string }> = {
        esencial: { title: "Comienza tu <span class='text-accent-bright'>prueba de 14 días</span>", cta: "Comenzar prueba de 14 días" },
        profesional: { title: "Solicita tu <span class='text-accent-bright'>demo gratuita</span>", cta: "Solicitar demo gratuita" },
        corporativo: { title: "Hablemos de <span class='text-accent-bright'>tu portafolio</span>", cta: "Hablar con ventas" },
      };

      if (plan && copy[plan]) {
        if (select) select.value = plan;
        if (title) title.innerHTML = copy[plan].title;
        if (label) label.textContent = copy[plan].cta;
      }

      // 2) UTM → campos ocultos
      ["utm_source", "utm_medium", "utm_campaign"].forEach((k) => {
        const input = document.querySelector<HTMLInputElement>(`input[name="${k}"]`);
        const v = params.get(k);
        if (input && v) input.value = v;
      });

      // 3) Evitar doble envío
      const form = document.getElementById("demo-form") as HTMLFormElement | null;
      const submit = document.getElementById("demo-submit") as HTMLButtonElement | null;
      form?.addEventListener("submit", () => {
        if (label) label.textContent = "Enviando…";
        setTimeout(() => {
          if (submit) submit.disabled = true;
        }, 0);
      });
    </script>
 </Base>