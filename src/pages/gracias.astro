---
/**
 * /gracias — Confirmación de solicitud de demo · Vecinal
 * ------------------------------------------------------------
 * Ubicación: src/pages/gracias.astro
 *
 * · `noindex`: no debe aparecer en buscadores (solo se llega al enviar el formulario).
 * · Aquí se dispara la CONVERSIÓN (ver bloque marcado más abajo).
 *
 * ⚙️ AJUSTA ESTAS CONSTANTES (las mismas de demo.astro):
 */
import Base from "../layouts/Base.astro";
import "../styles/global.css"; // ← ajusta la ruta si tu CSS vive en otro lugar

const WHATSAPP = "573000000000"; // ← número de ventas, con indicativo país, sin "+"
const TIEMPO_RESPUESTA = "menos de 24 horas hábiles";

const waLink = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent("Hola, acabo de solicitar una demo de Vecinal.")}`;

const icons = {
  check: '<path d="M20 6 9 17l-5-5"/>',
  arrowLeft: '<path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>',
  messageCircle: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>',
};

const steps = [
  { title: "Revisamos tu solicitud", text: `Un asesor la recibe y te contacta en ${TIEMPO_RESPUESTA}.` },
  { title: "Agendamos tu demo", text: "Te mostramos el panel y resolvemos tus dudas, sin compromiso." },
  { title: "Configuración asistida", text: "Si decides avanzar, dejamos todo listo en menos de 48 horas." },
];
---


   <Base title="Vecinal — Tu condominio, bajo control">

    <main class="bg-linear-to-b from-brand to-brand-deep section-pad">
      <div class="container-x rise mx-auto max-w-2xl text-center">
        <span class="mx-auto grid size-16 place-items-center rounded-full bg-accent-bright text-brand" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="size-8" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons.check} />
        </span>

        <h1 class="mt-6 text-4xl font-extrabold leading-[1.08] text-white sm:text-5xl">
          ¡Listo! <span class="text-accent-bright">Recibimos tu solicitud</span>
        </h1>
        <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-white/75">
          Te escribiremos por WhatsApp o correo en {TIEMPO_RESPUESTA} para agendar tu demo.
        </p>

        <!-- Qué sigue -->
        <ol class="mt-10 grid gap-4 text-left sm:grid-cols-3">
          {
            steps.map((s, i) => (
              <li class="rounded-card border border-white/10 bg-white/5 p-5">
                <span class="tnum grid size-8 place-items-center rounded-full bg-white/10 font-display text-sm font-bold text-accent-bright" aria-hidden="true">
                  {i + 1}
                </span>
                <h2 class="mt-3 font-display font-bold text-white">{s.title}</h2>
                <p class="mt-1 text-sm leading-relaxed text-white/70">{s.text}</p>
              </li>
            ))
          }
        </ol>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
          <a href={waLink} target="_blank" rel="noopener" class="btn-primary-dark">
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.messageCircle} />
            ¿Quieres adelantarte? Escríbenos
          </a>
          <a href="/" class="btn-secondary group">
            <svg viewBox="0 0 24 24" class="size-5 motion-safe:transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.arrowLeft} />
            Volver al inicio
          </a>
        </div>
      </div>
    </main>
</Base>

