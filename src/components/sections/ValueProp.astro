---
/**
 * ValueProposition — "Hoy vs. Con Vecinal" · v3 (split + compacto)
 * ------------------------------------------------------------
 * Comparativa en dos paneles alineados fila por fila:
 *   · Izquierda (claro): el dolor de hoy.
 *   · Derecha (petróleo): lo que cambia con Vecinal.
 * El color de cada lado ya comunica "antes/después", así que se
 * eliminaron las insignias ✕/✓. Una flecha central une cada par.
 *
 * `titulo` es el encabezado corto de cada mejora; `cambio`, el detalle.
 * Iconos: SVG inline estilo Lucide (stroke 1.75, sin dependencias).
 */

const icons = {
  files:
    '<path d="M20 7h-3a2 2 0 0 1-2-2V2"/><path d="M9 18a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h7l4 4v10a2 2 0 0 1-2 2Z"/><path d="M3 7.6v12.8A1.6 1.6 0 0 0 4.6 22h9.8"/>',
  userX:
    '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="m17 8 5 5"/><path d="m22 8-5 5"/>',
  calendarX:
    '<rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/><path d="m14 14-4 4"/><path d="m10 14 4 4"/>',
  database:
    '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/>',
  workflow:
    '<rect width="8" height="8" x="3" y="3" rx="2"/><path d="M7 11v4a2 2 0 0 0 2 2h4"/><rect width="8" height="8" x="13" y="13" rx="2"/>',
  bellRing:
    '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/><path d="M4 2C2.8 3.7 2 5.7 2 8"/><path d="M22 8c0-2.3-.8-4.3-2-6"/>',
  arrowRight: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
};

const rows = [
  {
    dolorIcon: icons.files,
    cambioIcon: icons.database,
    dolor: "La información vive en 6 archivos distintos y nadie sabe cuál es el último.",
    titulo: "Una sola fuente de verdad",
    cambio: "Cada propiedad, residente y transacción, actualizada en tiempo real.",
  },
  {
    dolorIcon: icons.userX,
    cambioIcon: icons.workflow,
    dolor: "Todo depende de ti. Si te tomas un día libre, la administración se detiene.",
    titulo: "Procesos que corren solos",
    cambio: "Solicitudes, aprobaciones y recordatorios estandarizados, con tu supervisión.",
  },
  {
    dolorIcon: icons.calendarX,
    cambioIcon: icons.bellRing,
    dolor: "Los morosos aparecen a fin de mes, cuando ya es tarde para cobrar.",
    titulo: "Cobro desde el primer día de mora",
    cambio: "Alertas automáticas de cartera vencida y recordatorios de pago programados.",
  },
];
---

<section id="valor" class="bg-surface px-6 py-14 sm:px-10 lg:px-16 lg:py-20" aria-labelledby="valor-title">
  <div class="container-x rise">
    <p class="eyebrow">Propuesta de valor</p>
    <h2 id="valor-title" class="max-w-3xl text-3xl font-bold leading-tight text-brand sm:text-4xl">
      Excel te sirvió cuando administrabas 30 unidades. <span class="text-accent">Ya no es el caso.</span>
    </h2>

    <div class="mt-8 overflow-hidden rounded-card border border-line shadow-card">
      <!-- Encabezados (solo escritorio) -->
      <div class="hidden grid-cols-2 text-xs font-semibold uppercase tracking-widest lg:grid" aria-hidden="true">
        <div class="bg-surface px-8 py-3 text-ink-soft">Hoy</div>
        <div class="flex items-center gap-2 bg-brand-deep px-8 py-3 text-accent-bright">
          <svg viewBox="0 0 62 56" class="h-3.5 w-auto">
            <polygon points="4,24 20,8 36,24 36,52 4,52" class="fill-white" />
            <polygon points="26,24 42,8 58,24 58,52 26,52" class="fill-accent-bright" />
            <polygon points="26,24 31,19 36,24 36,52 26,52" class="fill-brand-deep" />
          </svg>
          Con Vecinal
        </div>
      </div>

      <ul role="list">
        {
          rows.map((r, i) => (
            <li class="relative grid lg:grid-cols-2">
              <!-- DOLOR -->
              <div class:list={["flex items-start gap-4 bg-white p-5 sm:p-6 lg:p-8", i > 0 && "border-t border-line"]}>
                <span class="grid size-10 shrink-0 place-items-center rounded-control bg-surface text-ink-soft" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={r.dolorIcon} />
                </span>
                <p class="text-ink-soft">
                  <span class="mb-1 block text-xs font-semibold uppercase tracking-widest lg:sr-only">Hoy</span>
                  {r.dolor}
                </p>
              </div>

              <!-- Flecha central (escritorio) -->
              <span
                class="absolute left-1/2 top-1/2 z-10 hidden size-9 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-accent-bright text-brand shadow-card lg:grid"
                aria-hidden="true"
              >
                <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" set:html={icons.arrowRight} />
              </span>

              <!-- CAMBIO -->
              <div class:list={["flex items-start gap-4 bg-brand p-5 text-white sm:p-6 lg:p-8", i > 0 && "border-t border-white/10"]}>
                <span class="grid size-10 shrink-0 place-items-center rounded-control bg-white/10 text-accent-bright" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={r.cambioIcon} />
                </span>
                <div>
                  <span class="mb-1 block text-xs font-semibold uppercase tracking-widest text-accent-bright lg:sr-only">Con Vecinal</span>
                  <p class="font-display text-lg font-bold leading-snug text-white">{r.titulo}</p>
                  <p class="mt-1 text-white/75">{r.cambio}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a href="#demo" class="btn-primary group">
        Migrar mi administración
        <svg viewBox="0 0 24 24" class="size-5 motion-safe:transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.arrowRight} />
      </a>
      <p class="text-sm text-ink-soft">Migración asistida en 3 a 7 días. Tú solo verificas.</p>
    </div>
  </div>
</section>