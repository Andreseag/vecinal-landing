      ["Migración de datos", "Asistida completa"],
    ],
  },
  {
    name: "Corporativo",
    for: "Portafolios y administradoras grandes",
    price: null, // A medida
    cta: "Hablar con ventas",
    highlight: false,
    features: [
      ["Propiedades y Residentes", true],
      ["Mantenimiento y Pagos", true],
      ["Recordatorios automáticos de pago", true],
