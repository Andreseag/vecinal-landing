/**
 * Pricing — Planes en pesos colombianos (COP) · v2 UI
 * ------------------------------------------------------------
 * ⚙️ PARA CAMBIAR PRECIOS: edita `price` (entero en COP, mensual,
 *    SIN IVA) en cada plan. Todo lo demás se calcula solo:
 *    formato $ 149.000, equivalente mensual del plan anual,
 *    total anual y ahorro. Plan sin precio fijo → `price: null`.
 *
 * Interacción: toggle Mensual / Anual (por defecto Mensual).
 *   · Funciona con un script mínimo que cambia `data-billing`
 *     en la sección; el CSS (group-data-*) muestra el precio
 *     correcto. Sin JS, se ve la versión mensual completa.
 *
 * Supuestos (ajústalos):
 *   · IVA 19 % (solo informativo, se muestra "+ IVA").
 *   · Anual = 10 mensualidades (2 meses gratis).
 */

const MESES_ANUAL = 10;

const cop = new Intl.NumberFormat("es-CO", {
  style: "currency",
  currency: "COP",
  maximumFractionDigits: 0,
});

// Equivalente mensual del plan anual, redondeado al millar
const mensualEnAnual = (price: number) =>
  Math.round((price * MESES_ANUAL) / 12 / 1000) * 1000;

// Iconos SVG (viewBox 24x24, estilo Lucide)
const icons = {
  check: '<path d="M20 6 9 17l-5-5"/>',
  minus: '<path d="M5 12h14"/>',
  arrowRight: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  star: '<path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/>',
  shieldCheck: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  rotateCcw: '<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/>',
  fileText: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>',
};

const plans = [
  {
    name: "Esencial",
    for: "Conjuntos y edificios de hasta 100 unidades",
    price: 149000,
    cta: "Comenzar prueba de 14 días",
    highlight: false,
    features: [
      ["Propiedades y Residentes", true],
      ["Mantenimiento y Pagos", true],
      ["Recordatorios automáticos de pago", true],
      ["Amenidades y Control de Acceso", false],
      ["Dashboard y analítica", "Básico"],
      ["Usuarios / Roles", "3 usuarios"],
      ["Soporte", "Email"],
      ["Migración de datos", "Guiada"],
    ],
  },
  {
    name: "Profesional",
    for: "Administradoras con 1–5 conjuntos",
    price: 449000,
    cta: "Solicitar demo",
    highlight: true,
    features: [
      ["Propiedades y Residentes", true],
      ["Mantenimiento y Pagos", true],
      ["Recordatorios automáticos de pago", true],
      ["Amenidades y Control de Acceso", true],
      ["Dashboard y analítica", "Completo"],
      ["Usuarios / Roles", "Ilimitados"],
      ["Soporte", "Prioritario (<4h)"],
      ["Migración de datos", "Asistida completa"],
    ],
  },
  {
    name: "Corporativo",
    for: "Portafolios y administradoras grandes",
    price: null, // A medida
    cta: "Hablar con ventas",
    highlight: false,
    features: [
      ["Propiedades y Residentes", true],
      ["Mantenimiento y Pagos", true],
      ["Recordatorios automáticos de pago", true],
      ["Amenidades y Control de Acceso", true],
      ["Dashboard y analítica", "Completo + reportes"],
      ["Usuarios / Roles", "Ilimitados + SSO"],
      ["Soporte", "Gerente de cuenta"],
      ["Migración de datos", "Llave en mano"],
    ],
  },
];

const trust = [
  { icon: icons.shieldCheck, title: "14 días sin tarjeta", text: "Pruébalo completo antes de pagar." },
  { icon: icons.rotateCcw, title: "Garantía de devolución", text: "Si no te ahorra tiempo en el primer mes, te devolvemos el dinero." },
  { icon: icons.fileText, title: "Factura electrónica", text: "Incluida en todos los planes, sin costos de instalación." },
];
---

<section id="precios" class="group/pricing section-pad" data-billing="mensual" aria-labelledby="precios-title">
  <div class="container-x rise">
    <!-- Encabezado + toggle -->
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="eyebrow">Precios</p>
        <h2 id="precios-title" class="max-w-3xl text-3xl font-bold text-brand sm:text-4xl">
          Un plan para <span class="text-accent">cada tamaño de comunidad</span>
        </h2>
        <p class="mt-4 max-w-2xl text-ink-soft">
          Precios en pesos colombianos (COP) por mes, más IVA. Sin costos de instalación.
        </p>
      </div>

      <div class="inline-flex w-fit rounded-full border border-line bg-white p-1 shadow-card" role="group" aria-label="Periodo de facturación">
        <button
          type="button"
          data-billing-btn="mensual"
          aria-pressed="true"
          class="min-h-11 rounded-full px-5 text-sm font-semibold text-ink-soft transition-colors hover:text-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent aria-pressed:bg-brand aria-pressed:text-white"
        >
          Mensual
        </button>
        <button
          type="button"
          data-billing-btn="anual"
          aria-pressed="false"
          class="inline-flex min-h-11 items-center gap-2 rounded-full px-5 text-sm font-semibold text-ink-soft transition-colors hover:text-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent aria-pressed:bg-brand aria-pressed:text-white"
        >
          Anual
          <span class="rounded-full bg-mint px-2 py-0.5 text-xs font-bold text-brand">2 meses gratis</span>
        </button>
      </div>
    </div>

    <!-- Planes -->
    <div class="mt-14 grid items-stretch gap-6 lg:grid-cols-3">
      {
        plans.map((p) => (
          <article
            class:list={[
              "relative flex flex-col rounded-card border p-7 sm:p-8 motion-safe:transition motion-safe:duration-200",
              p.highlight
                ? "border-accent-bright/40 bg-brand text-white shadow-pop lg:-my-4 lg:py-12"
                : "border-line bg-surface text-ink motion-safe:hover:-translate-y-1 hover:shadow-card",
            ]}
          >
            {p.highlight && (
              <span class="absolute left-1/2 top-0 inline-flex -translate-x-1/2 -translate-y-1/2 items-center gap-1.5 rounded-full bg-accent-bright px-4 py-1.5 text-xs font-bold text-brand shadow-card">
                <svg viewBox="0 0 24 24" class="size-3.5" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true" set:html={icons.star} />
                Más elegido
              </span>
            )}

            <!-- Nombre -->
            <h3 class="font-display text-xl font-bold">{p.name}</h3>
            <p class:list={["mt-1 min-h-10 text-sm", p.highlight ? "text-white/70" : "text-ink-soft"]}>{p.for}</p>

            <!-- Precio -->
            <div class:list={["mt-6 min-h-[7.5rem] border-t pt-6", p.highlight ? "border-white/15" : "border-line"]}>
              {p.price !== null ? (
                <>
                  <!-- Mensual -->
                  <div class="group-data-[billing=anual]/pricing:hidden">
                    <p class="tnum flex flex-wrap items-baseline gap-x-1.5 font-display text-4xl font-extrabold tracking-tight">
                      {cop.format(p.price)}
                      <span class:list={["text-sm font-medium tracking-normal", p.highlight ? "text-white/70" : "text-ink-soft"]}>/mes</span>
                    </p>
                    <p class:list={["mt-2 text-xs", p.highlight ? "text-white/70" : "text-ink-soft"]}>+ IVA · cancela cuando quieras</p>
                  </div>
                  <!-- Anual -->
                  <div class="hidden group-data-[billing=anual]/pricing:block">
                    <p class="tnum flex flex-wrap items-baseline gap-x-1.5 font-display text-4xl font-extrabold tracking-tight">
                      {cop.format(mensualEnAnual(p.price))}
                      <span class:list={["text-sm font-medium tracking-normal", p.highlight ? "text-white/70" : "text-ink-soft"]}>/mes</span>
                    </p>
                    <p class:list={["tnum mt-2 text-xs", p.highlight ? "text-white/70" : "text-ink-soft"]}>
                      {cop.format(p.price * MESES_ANUAL)} + IVA, facturado al año
                    </p>
                    <p class:list={["tnum mt-2 inline-block rounded-full px-2.5 py-0.5 text-xs font-bold", p.highlight ? "bg-accent-bright/15 text-mint" : "bg-accent/10 text-accent"]}>
                      Ahorras {cop.format(p.price * (12 - MESES_ANUAL))}
                    </p>
                  </div>
                </>
              ) : (
                <>
                  <p class="font-display text-4xl font-extrabold tracking-tight">A medida</p>
                  <p class="mt-2 text-xs text-ink-soft">Cotización según portafolio y número de unidades</p>
                </>
              )}
            </div>

            <!-- CTA -->
            <a href="/demo" class:list={["group mt-6 w-full", p.highlight ? "btn-primary-dark" : "btn-outline"]}>
              {p.cta}
              <svg viewBox="0 0 24 24" class="size-5 motion-safe:transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.arrowRight} />
            </a>

            <!-- Características: etiqueta a la izquierda, estado a la derecha -->
            <ul role="list" class:list={["mt-8 flex-1 divide-y text-sm", p.highlight ? "divide-white/10" : "divide-line"]}>
              {p.features.map(([label, val]) => (
                <li class="flex items-center justify-between gap-4 py-3">
                  <span class:list={[val === false ? (p.highlight ? "text-white/45" : "text-ink-soft/70") : p.highlight ? "text-white/90" : "text-ink"]}>
                    {label}
                  </span>
                  {val === true && (
                    <span class:list={["grid size-6 shrink-0 place-items-center rounded-full", p.highlight ? "bg-accent-bright/15 text-accent-bright" : "bg-accent/10 text-accent"]}>
                      <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.check} />
                      <span class="sr-only">Incluido</span>
                    </span>
                  )}
                  {val === false && (
                    <span class:list={["grid size-6 shrink-0 place-items-center", p.highlight ? "text-white/30" : "text-ink-soft/50"]}>
                      <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" set:html={icons.minus} />
                      <span class="sr-only">No incluido</span>
                    </span>
                  )}
                  {typeof val === "string" && (
                    <span class:list={["shrink-0 rounded-full px-2.5 py-0.5 text-xs font-semibold", p.highlight ? "bg-white/10 text-mint" : "bg-white text-brand ring-1 ring-line"]}>
                      {val}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <!-- Garantías -->
    <ul role="list" class="mt-14 grid gap-4 sm:grid-cols-3">
      {
        trust.map((t) => (
          <li class="flex items-start gap-4 rounded-card border border-line bg-white p-5">
            <span class="grid size-10 shrink-0 place-items-center rounded-control bg-accent/10 text-accent" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={t.icon} />
            </span>
            <div>
              <p class="font-display font-bold text-brand">{t.title}</p>
              <p class="mt-1 text-sm text-ink-soft">{t.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Toggle Mensual / Anual: cambia data-billing y el estado de los botones
  const root = document.getElementById("precios");
  const buttons = root?.querySelectorAll<HTMLButtonElement>("[data-billing-btn]");

  buttons?.forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!root) return;
      root.dataset.billing = btn.dataset.billingBtn;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
    });
  });
</script>