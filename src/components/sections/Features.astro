---
/**
 * Modules — Módulos de la plataforma · v2 (compacto)
 * ------------------------------------------------------------
 * · 6 tarjetas con icono Lucide (SVG inline, stroke 1.75).
 * · Banda inferior con las dos capacidades transversales
 *   (seguridad + dashboard central).
 * · Textos de cada módulo sin cambios; "condominio" → "conjunto".
 */

const icons = {
  building:
    '<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/>',
  users:
    '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  wrench:
    '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  wallet:
    '<path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/>',
  calendarCheck:
    '<rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/>',
  doorOpen:
    '<path d="M13 4h3a2 2 0 0 1 2 2v14"/><path d="M2 20h3"/><path d="M13 20h9"/><path d="M10 12v.01"/><path d="M13 4.562v16.157a1 1 0 0 1-1.242.97L5 20V5.562a2 2 0 0 1 1.515-1.94l4-1A2 2 0 0 1 13 4.561Z"/>',
  lock: '<rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  dashboard:
    '<rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  arrowRight: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
};

const modules = [
  {
    title: "Propiedades",
    icon: icons.building,
    copy: "Cada inmueble con su historia completa: residentes vinculados, estado de cuenta, solicitudes activas y documentos. Responde «¿quién vive en la torre B, piso 4?» en 3 segundos, no en 30 minutos.",
    benefit: "Elimina la búsqueda manual entre archivos.",
  },
  {
    title: "Residentes y Propietarios",
    icon: icons.users,
    copy: "Directorio completo con perfiles, viviendas asociadas e historial de cada residente. Altas y cambios de ocupante sin papelitos ni llamadas a portería.",
    benefit: "Onboarding y transición de residentes sin fricción.",
  },
  {
    title: "Mantenimiento",
    icon: icons.wrench,
    copy: "Las solicitudes dejan de perderse en WhatsApp. Cada reporte queda registrado, con seguimiento de estado y aprobación centralizada.",
    benefit: "Trazabilidad total y cero solicitudes olvidadas.",
  },
  {
    title: "Pagos",
    icon: icons.wallet,
    copy: "Historial financiero de cada unidad, control de transacciones y recordatorios automáticos. La cartera morosa deja de ser una sorpresa mensual.",
    benefit: "Mejor flujo de caja y cobro sin confrontaciones.",
  },
  {
    title: "Amenidades y Áreas Comunales",
    icon: icons.calendarCheck,
    copy: "Salón social, canchas, piscina y BBQ con calendario de reservas centralizado. Conflictos por doble reserva: cosa del pasado.",
    benefit: "Convivencia sin fricciones y uso rentable de áreas comunes.",
  },
  {
    title: "Control de Acceso",
    icon: icons.doorOpen,
    copy: "Registro detallado de visitantes, visitas recurrentes y entradas. Residentes con respaldo de quién ingresó y cuándo.",
    benefit: "Seguridad auditable y menos incidentes en acceso.",
  },
];

const platform = [
  {
    icon: icons.lock,
    title: "Acceso seguro",
    text: "Autenticación segura y recuperación de credenciales sin llamadas al soporte.",
  },
  {
    icon: icons.dashboard,
    title: "Dashboard central",
    text: "Ocupación, cartera, solicitudes y reservas en una sola vista.",
  },
];
---

<section id="modulos" class="px-6 py-14 sm:px-10 lg:px-16 lg:py-20" aria-labelledby="modulos-title">
  <div class="container-x rise">
    <p class="eyebrow">Módulos</p>
    <h2 id="modulos-title" class="max-w-3xl text-3xl font-bold text-brand sm:text-4xl">
      Todo lo que tu conjunto necesita. <span class="text-accent">Nada que no uses.</span>
    </h2>
    <p class="mt-3 max-w-2xl text-ink-soft">
      Seis módulos integrados, un solo panel. Activa solo los que tu comunidad necesita.
    </p>

    <!-- Módulos -->
    <ul role="list" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
      {
        modules.map((m, i) => (
          <li>
            <article class="group relative flex h-full flex-col rounded-card border border-line bg-surface p-5 motion-safe:transition motion-safe:duration-200 motion-safe:hover:-translate-y-1 hover:border-accent/40 hover:bg-white hover:shadow-card sm:p-6">
              <span class="tnum absolute right-5 top-5 text-xs font-semibold text-ink-soft/60" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>

              <span class="grid size-11 place-items-center rounded-control bg-accent/10 text-accent transition-colors duration-200 group-hover:bg-accent group-hover:text-white" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={m.icon} />
              </span>

              <h3 class="mt-4 text-lg font-bold text-brand">{m.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-soft">{m.copy}</p>

              <p class="mt-4 flex items-start gap-2 border-t border-line pt-3 text-xs font-semibold text-accent">
                <svg viewBox="0 0 24 24" class="mt-px size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.check} />
                {m.benefit}
              </p>
            </article>
          </li>
        ))
      }
    </ul>

    <!-- Capacidades transversales -->
    <div class="mt-6 grid gap-6 rounded-card bg-brand p-6 text-white sm:grid-cols-2 sm:p-8">
      {
        platform.map((p) => (
          <div class="flex items-start gap-4">
            <span class="grid size-11 shrink-0 place-items-center rounded-control bg-white/10 text-accent-bright" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
            </span>
            <div>
              <h3 class="font-display text-lg font-bold">{p.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-white/75">{p.text}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-8">
      <a href="/demo" class="btn-outline group">
        Explorar todos los módulos
        <svg viewBox="0 0 24 24" class="size-5 motion-safe:transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.arrowRight} />
      </a>
    </div>
  </div>
</section>