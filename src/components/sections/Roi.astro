---
/**
 * ROI — Retorno de inversión · v2 (compacto)
 * ------------------------------------------------------------
 * · Dos columnas en escritorio: mensaje + CTA a la izquierda,
 *   métricas 2×2 a la derecha (menos altura que 4 columnas apiladas).
 * · Cada métrica lleva un icono Lucide (SVG inline).
 * · Números en `accent-bright`: el `success` anterior (#15803d) casi
 *   no se leía sobre el fondo petróleo.
 */

const icons = {
  clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
  trendingDown: '<path d="M16 17h6v-6"/><path d="m22 17-8.5-8.5-5 5L2 7"/>',
  search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  clipboardCheck:
    '<rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/>',
  arrowRight: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
};

const metrics = [
  { icon: icons.clock, value: "15+", unit: "horas", label: "ahorradas por semana en tareas administrativas manuales." },
  { icon: icons.trendingDown, value: "−40 %", unit: "", label: "cartera morosa gracias a recordatorios automáticos tempranos." },
  { icon: icons.search, value: "3", unit: "segundos", label: "para localizar cualquier dato de residente, unidad o transacción." },
  { icon: icons.clipboardCheck, value: "0", unit: "", label: "solicitudes perdidas: trazabilidad completa del reporte a la resolución." },
];
---

<section id="roi" class="bg-brand px-6 py-14 text-white sm:px-10 lg:px-16 lg:py-20" aria-labelledby="roi-title">
  <div class="container-x rise grid items-center gap-10 lg:grid-cols-[5fr_7fr] lg:gap-14">
    <!-- Mensaje -->
    <div>
      <p class="eyebrow-dark">Retorno de inversión</p>
      <h2 id="roi-title" class="text-3xl font-bold sm:text-4xl">
        El software se paga solo. <span class="text-accent-bright">De hecho, te paga.</span>
      </h2>
      <p class="mt-4 text-white/70">
        Estos son los números que reportan nuestras administradoras en los primeros 90 días.
      </p>

      <p class="mt-6 text-white/80">
        Una administradora que atiende 5 conjuntos residenciales recupera, en promedio,
        <strong class="font-semibold text-white">más de un día completo de trabajo cada semana</strong>. Ese tiempo se
        convierte en más portafolio administrado, mejor servicio a las copropiedades — o simplemente en salir a la
        hora, por primera vez en años.
      </p>

      <div class="mt-7">
        <a href="#demo" class="btn-primary-dark group">
          Calcular mi ahorro
          <svg viewBox="0 0 24 24" class="size-5 motion-safe:transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.arrowRight} />
        </a>
      </div>
    </div>

    <!-- Métricas -->
    <ul role="list" class="grid gap-4 sm:grid-cols-2">
      {
        metrics.map((m) => (
          <li class="flex flex-col rounded-card border border-white/10 bg-white/5 p-5 sm:p-6">
            <span class="grid size-10 place-items-center rounded-control bg-white/10 text-accent-bright" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={m.icon} />
            </span>
            <p class="tnum mt-4 font-display text-4xl font-extrabold tracking-tight text-accent-bright">
              {m.value}{m.unit && <span class="ml-1.5 text-lg font-bold text-white/70">{m.unit}</span>}
            </p>
            <p class="mt-1.5 text-sm leading-relaxed text-white/70">{m.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>