---
/**
 * FAQ — Preguntas frecuentes · v2 UI
 * ------------------------------------------------------------
 * Acordeón nativo con <details> (accesible sin JS).
 *   · `name="faq"` hace el acordeón exclusivo: abrir una pregunta
 *     cierra la anterior (navegadores modernos; en los demás
 *     simplemente se pueden abrir varias).
 *   · La primera pregunta viene abierta (`open: true`).
 *   · Para agregar preguntas, añade objetos a `faqs`.
 */

const icons = {
  plus: '<path d="M5 12h14"/><path d="M12 5v14"/>',
  messageCircle: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>',
  arrowRight: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
};

const faqs = [
  {
    q: "¿Cuánto tarda la migración desde Excel?",
    a: "Con nuestro proceso asistido, entre 3 y 7 días según el volumen de unidades. Nosotros cargamos tus datos y tú solo verificas.",
    open: true,
  },
  {
    q: "¿Los residentes necesitan instalar algo?",
    a: "No. Los residentes interactúan por correo y enlaces seguros; el panel completo es para tu equipo administrativo.",
  },
  {
    q: "¿Puedo empezar con un solo módulo?",
    a: "Sí. Activa solo lo que necesitas —por ejemplo, Pagos— y escala a los demás módulos cuando estés listo.",
  },
];
---

<section id="faq" class="section-pad bg-surface" aria-labelledby="faq-title">
  <div class="container-x rise grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
    <!-- Columna izquierda: título + ayuda -->
    <div class="lg:sticky lg:top-28 lg:self-start">
      <p class="eyebrow">Preguntas frecuentes</p>
      <h2 id="faq-title" class="text-3xl font-bold text-brand sm:text-4xl">
        Antes de <span class="text-accent">decidir</span>
      </h2>
      <p class="mt-4 max-w-md text-ink-soft">
        Lo que más nos preguntan los administradores antes de dejar Excel. Si no ves tu duda, escríbenos.
      </p>

      <div class="mt-8 flex items-start gap-4 rounded-card border border-line bg-white p-5">
        <span class="grid size-10 shrink-0 place-items-center rounded-control bg-accent/10 text-accent" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={icons.messageCircle} />
        </span>
        <div>
          <p class="font-display font-bold text-brand">¿Tienes otra duda?</p>
          <p class="mt-1 text-sm text-ink-soft">Agenda una demo y resolvemos tu caso con tus propios datos.</p>
          <a href="#demo" class="link-brand group mt-3 inline-flex items-center gap-1.5 text-sm">
            Hablar con el equipo
            <svg viewBox="0 0 24 24" class="size-4 motion-safe:transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.arrowRight} />
          </a>
        </div>
      </div>
    </div>

    <!-- Columna derecha: acordeón -->
    <div class="space-y-3">
      {
        faqs.map((f) => (
          <details
            name="faq"
            open={f.open}
            class="faq-item group rounded-card border border-line bg-white transition-shadow open:border-accent/30 open:shadow-card"
          >
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 rounded-card px-6 py-5 text-left font-display text-base font-semibold text-brand focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent sm:text-lg [&::-webkit-details-marker]:hidden">
              {f.q}
              <span class="grid size-8 shrink-0 place-items-center rounded-full bg-accent/10 text-accent motion-safe:transition motion-safe:duration-200 group-open:rotate-45 group-open:bg-accent group-open:text-white" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" set:html={icons.plus} />
              </span>
            </summary>
            <p class="px-6 pb-6 pr-16 text-base leading-relaxed text-ink-soft">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Apertura suave (mejora progresiva: Chrome/Edge 131+, el resto abre sin animación) */
  :global(:root) {
    interpolate-size: allow-keywords;
  }
  .faq-item::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.25s ease,
      content-visibility 0.25s allow-discrete;
  }
  .faq-item[open]::details-content {
    block-size: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-item::details-content {
      transition: none;
    }
  }
</style>